# Copy to .env and adjust as needed. All settings are optional (sensible defaults apply).
APP_MAX_FILE_SIZE_MB=25
# JSON list of allowed CORS origins
APP_CORS_ORIGINS=["http://localhost:3000"]
# Spoken answers, via Gemini text-to-speech. Leave the key unset to keep the
# feature off; the chat UI then disables its voice toggle.
APP_GOOGLE_API_KEY=
APP_TTS_VOICE=Kore
